          "avatar": "assets/img/avatar-3.jpg"
        }
      ]
    },

    "contact": {
      "hero": {
        "title": "Contact",
        "subtitle": "Expliquez votre besoin — nous revenons vers vous rapidement.",
        "background": { "type": "solid", "color": "gray50" }
      },
      "split": {
        "left": {
          "title": "Envoyez-nous un message",
          "helper": "Réponse sous 30 minutes pendant les heures ouvrables (à ajuster).",
          "fields": [
            { "name": "firstName", "label": "Prénom", "type": "text", "required": true, "grid": { "md": 6 } },
            { "name": "lastName", "label": "Nom", "type": "text", "required": true, "grid": { "md": 6 } },
            { "name": "phone", "label": "Téléphone", "type": "tel", "required": true, "grid": { "md": 6 } },
            { "name": "email", "label": "Email", "type": "email", "required": true, "grid": { "md": 6 } },
            {
              "name": "service",
              "label": "Service",
              "type": "select",
              "required": true,
              "grid": { "md": 12 },
              "options": ["Audit", "Expertise comptable", "Fiscalité", "Conseil & stratégie", "Digitalisation", "Formation"]
            },
            { "name": "message", "label": "Message", "type": "textarea", "required": true, "rows": 5, "grid": { "md": 12 } }
          ],
          "submit": { "label": "Envoyer", "variant": "primary", "icon": "arrow-right" }
        },
        "right": {
          "cards": [
            {
              "icon": "map-pin",
              "title": "Adresse",
              "text": "N'Djamena, Tchad (à préciser)",
              "accentColor": "primary"
            },
            {
              "icon": "phone",
              "title": "Téléphone",
              "text": "+235 XX XX XX XX (à préciser)",
              "accentColor": "primary"
            },
            {
              "icon": "mail",
              "title": "Email",
              "text": "contact@sec-consulting.org (à préciser)",
              "accentColor": "primary"
            }
          ]
        }
      }
    }
  },

  "ui_composition": {
    "appShell": {
      "header": {
        "type": "SiteHeader",
        "props": {
          "nav": "@content.nav",
          "logoText": "@content.siteName",
          "cta": "@content.primaryCTA",
          "style": {
            "background": "white",
            "sticky": true,
            "borderBottom": "1px solid rgba(0,0,0,0.06)"
          },
          "mobile": { "menu": "drawer", "ctaPlacement": "bottom" }
        }
      },
      "footer": {
        "type": "SiteFooter",
        "props": {
          "background": "textDark",
          "textColor": "white",
          "columns": [
            {
              "title": "SEC-CONSULTING",
              "text": "Cabinet d’audit, expertise comptable, conseil, digitalisation et formation."
            },
            {
              "title": "Liens",
              "links": [
                { "label": "À propos", "route": "/a-propos" },
                { "label": "Services", "route": "/services" },
                { "label": "Études de cas", "route": "/etudes-de-cas" },
                { "label": "Contact", "route": "/contact" }
              ]
            },
            {
              "title": "Services",
              "links": [
                { "label": "Audit", "route": "/services#audit" },
                { "label": "Expertise comptable", "route": "/services#comptabilite" },
                { "label": "Fiscalité", "route": "/services#fiscalite" },
                { "label": "Digitalisation", "route": "/services#digital" }
              ]
            }
          ],
          "social": [
            { "name": "Facebook", "href": "#" },
            { "name": "LinkedIn", "href": "#" }
          ]
        }
      }
    },

    "pages": [
      {
        "route": "/",
        "name": "Home",
        "sections": [
          { "type": "HeroSection", "propsRef": "@content.home.hero" },
          { "type": "LogoMarquee", "propsRef": "@content.home.partners" },
          { "type": "FeatureCards", "propsRef": "@content.home.whyUs" },
          { "type": "ServiceCards", "propsRef": "@content.home.servicesPreview" },
          { "type": "Steps", "propsRef": "@content.home.method" },
          { "type": "KpiSplit", "propsRef": "@content.home.proof" },
          { "type": "TestimonialCarousel", "propsRef": "@content.testimonials" },
          { "type": "FinalCtaBand", "propsRef": "@content.home.finalCta" }
        ]
      },
      {
        "route": "/a-propos",
        "name": "About",
        "sections": [
          { "type": "PageHero", "propsRef": "@content.about.hero" },
          { "type": "SplitIntro", "propsRef": "@content.about.intro" },
          { "type": "TwoCardBand", "propsRef": "@content.about.missionVision" },
          { "type": "IconGrid", "propsRef": "@content.about.values" },
          { "type": "FinalCtaBand", "propsRef": "@content.home.finalCta" }
        ]
      },
      {
        "route": "/services",
        "name": "Services",
        "sections": [
          { "type": "PageHero", "propsRef": "@content.services.hero" },
          { "type": "ServiceSections", "propsRef": "@content.services.sections" },
          { "type": "TestimonialCarousel", "propsRef": "@content.testimonials" },
          { "type": "FinalCtaBand", "propsRef": "@content.home.finalCta" }
        ]
      },
      {
        "route": "/etudes-de-cas",
        "name": "CaseStudies",
        "sections": [
          { "type": "PageHero", "propsRef": "@content.caseStudies.hero" },
          { "type": "FilterableCaseGrid", "propsRef": "@content.caseStudies" },
          { "type": "HighlightBand", "propsRef": "@content.caseStudies.highlightBand" },
          { "type": "FinalCtaBand", "propsRef": "@content.home.finalCta" }
        ]
      },
      {
        "route": "/equipe",
        "name": "Team",
        "sections": [
